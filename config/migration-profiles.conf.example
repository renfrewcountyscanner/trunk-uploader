# Sanitized migration configuration derived from the active reference archives.
# Every destination is disabled until URLs, credentials, and talkgroups are reviewed.
[general]
config_version = 1
default_profile = fleetnet-pembroke
database = data/uploader.sqlite3
spool_dir = spool
log_level = INFO
ffmpeg = /usr/bin/ffmpeg
mp3_bitrate = 64k
retry_max_attempts = 8
retry_base_seconds = 30
retry_max_seconds = 3600

[method:rdio]
enabled = yes

[method:icad]
enabled = yes

[method:trunk-recording]
enabled = yes

[profile:ems-paging]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = no

[profile:renfrew-fire-paging]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = no

[profile:fleetnet-kingston]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = yes

[profile:fleetnet-multi-site]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = yes

[profile:fleetnet-pembroke]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = yes

[profile:kingston-area-paging]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = no

[profile:ottawa-renfrew-lanark-paging]
enabled = yes
rdio_enabled = yes
icad_enabled = yes
trunk_recording_enabled = no

[rdio:ems-paging-rdio]
enabled = no
profile = ems-paging
url = https://radio.example.invalid
api_key = CHANGE_ME
system_id = 1
talkgroups = *
exclude_talkgroups =

